{
    "name": "jsonld2html-cards",
    "version": "1.0.0",
    "license": "MIT",
    "dependencies": {
        "mustache": "^4.2.0"
    },
    "main": "jsonld2html-bundle.js",
    "exports": {
        ".": {
            "import": "./jsonld2html-bundle.mjs",
            "require": "./jsonld2html-bundle.js"
        },
        "./*": "./*"
    },
    "scripts": {
        "build": "rollup -c rollup.config.umd.mjs && rollup -c rollup.config.esm.mjs",
        "test": "npm run test-lint && npm run test-unit && npm run test-output",
        "test-lint": "eslint --ignore-pattern 'test' --ignore-pattern '*-bundle.js' .",
        "test-unit": "jest",
        "test-output": "cd test/ && node render.js",
        "prepublishOnly": "npm run build"
    },
    "devDependencies": {
        "@rollup/plugin-json": "^6.1.0",
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "rollup": "^4.9.2",
        "rollup-plugin-html": "^0.2.1"
    }
}
